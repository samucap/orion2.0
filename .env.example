ENV=development
# Production: set POSTGRES_URL (must include sslmode=require). It takes priority over the POSTGRES_* vars below.
# POSTGRES_URL=postgres://user:pass@host:5432/db?sslmode=require
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Defaults to require. Use disable only for a local Postgres without TLS.
POSTGRES_SSLMODE=disable
# Must be at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRY_MINUTES=15
BCRYPT_COST=12
AUTH_ENABLED=true
# Frontend origin allowed by CORS. Empty falls back to http://localhost:*
# CLIENT_URL=https://your-frontend.vercel.app
